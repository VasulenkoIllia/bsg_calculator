# ────────────────────────────────────────────────────────────────────
# BSG Calculator — environment configuration
# Copy this file to `.env` (gitignored) and fill in secrets locally.
# Production values live in Coolify / VPS deployment env, NOT here.
# ────────────────────────────────────────────────────────────────────

# ─── App / runtime ──────────────────────────────────────────────────
APP_NAME=bsg-calculator
# Public host name. Only production uses it (the Traefik rule in
# docker-compose.yml and the startup log); set the real host there.
APP_DOMAIN=localhost
# Public URL of the SPA — embedded as the clickable document link in
# every CRM note (a monday update). In dev, the Vite proxy serves both
# SPA and /api/* from the same origin, so localhost is fine. In prod
# this MUST be the real https origin (env loader rejects localhost
# in production).
APP_PUBLIC_URL=http://localhost:5173
NODE_ENV=development
PORT=8080
TZ=Europe/Kyiv

# ─── Reverse proxy (Traefik) — production only ──────────────────────
TRAEFIK_NETWORK=proxy
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_TLS=true
TRAEFIK_CERTRESOLVER=cf
# Number of trusted reverse-proxy hops in front of Express. Express
# trusts the LAST N entries of X-Forwarded-For when extracting req.ip.
# An incorrect value lets a client spoof their IP and bypass per-IP
# rate limits — set this to match the real topology.
#   1 = Traefik (default, our deploy)  |  0 = no proxy
TRUST_PROXY_HOPS=1

# ─── Database (Postgres) ────────────────────────────────────────────
# Phase 8: single Postgres sibling container managed via docker-compose.
# Drizzle reads DATABASE_URL directly; the individual vars are exposed
# so docker-compose can render the postgres image config from one source.
# Dev: docker-compose.dev.yml exposes Postgres on 5433 to avoid conflicts
# with a local Postgres on the host. Production uses standard 5432.
DATABASE_URL=postgres://bsg:bsg_dev_password@localhost:5433/bsg_calculator
DB_HOST=localhost
DB_PORT=5433
DB_USER=bsg
DB_PASSWORD=bsg_dev_password
DB_NAME=bsg_calculator
# Connection pool size for the API process. Each Puppeteer render
# briefly borrows a connection; 10 is comfortable for a single VPS.
DB_POOL_MAX=10
# How long a request waits for a free pool client before failing. pg's
# default is 0 = wait forever, which makes pool starvation look like the
# app simply hanging: no error, no log line, requests never answer.
DB_CONNECTION_TIMEOUT_MS=10000

# ─── Auth (JWT + bcrypt) ────────────────────────────────────────────
# IMPORTANT: regenerate the access secret per environment.
#   openssl rand -base64 48
# Access tokens are short-lived (15 min) and signed with JWT_ACCESS_SECRET.
# Refresh tokens are opaque random strings (30 days), SHA-256-hashed in
# the `refresh_tokens` table — they are NOT JWTs and need no secret.
JWT_ACCESS_SECRET=replace_me_with_openssl_rand_base64_48_dev_only
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=12h
# bcrypt cost. 12 ≈ 250ms hash on a typical VPS. Increase to 13 if
# the VPS CPU is significantly faster than the staging baseline.
BCRYPT_COST=12
# TOTP 2FA — AES-256-GCM key for encrypting per-user TOTP secrets at rest.
# 64 hex chars (32 bytes). Dev defaults to all-zeros if unset; prod MUST
# set a real key (the app refuses to boot with the dev default in prod).
# Generate: openssl rand -hex 32
TOTP_ENCRYPTION_KEY=

# ─── CORS / frontend origin ─────────────────────────────────────────
# In Phase 8 the Express server also serves the SPA static bundle, so
# CORS only matters during local dev when Vite runs on its own port.
FRONTEND_ORIGIN=http://localhost:5173

# ─── CRM provider ───────────────────────────────────────────────────
# monday.com is the ONLY CRM (production since 2026-08-28). The HubSpot
# account no longer exists, so "hubspot" is neither a fallback nor a
# rollback target. Production sets CRM_PROVIDER=monday explicitly (see
# .env.production.example): the code default in server/config/env.ts is
# still "hubspot" — changing it is a deferred code change.
# It selects the client the note-writer uses, the webhook processor that
# starts at boot, the API /ready probes and the CRM the TTL refresh reads
# from. A note is only ever torn down in the CRM that recorded it.
# Left commented out here on purpose: the env loader also reads this file
# when the SERVER TESTS run, and part of the suite assumes the code
# default. Uncomment it only for a local server that talks to monday. It
# then also needs MONDAY_API_TOKEN; without one the server still boots,
# but the startup API-version check fails at ERROR and the monday webhook
# processor and scheduled backfill are not started.
# CRM_PROVIDER=monday

# ─── monday.com ─────────────────────────────────────────────────────
# Personal API token (Developer Center -> My access tokens). Every read
# and every note write goes through it. Required in production (boot
# refuses without it); optional in dev.
# MONDAY_API_TOKEN=
# Must be exactly this in production (SSRF guard for the token).
MONDAY_API_BASE_URL=https://api.monday.com/v2
# Pinned API version, asserted at boot. monday ships quarterly and an
# UNRECOGNISED value is silently downgraded instead of rejected, so the
# server checks that monday echoes back what we asked for and does not
# start the webhook processor or the scheduled backfill otherwise.
# Never leave blank.
MONDAY_API_VERSION=2026-07
# Board ids in the CRM workspace (the env.ts defaults are
# the real boards). Column ids are NOT env vars on purpose: they are
# resolved at runtime — recorded id first, then title + type — because
# mapped columns were deleted and recreated during the migration.
MONDAY_BOARD_COMPANIES=5102466967
MONDAY_BOARD_AGENTS=5102466950
MONDAY_BOARD_DEALS=5102466996
# These three must be DIFFERENT ids — boot refuses otherwise. The webhook
# receiver classifies an event by its board id, so a duplicate would route
# one board's events to the wrong object type with nothing in the logs to
# say so.
# Unguessable path segment for POST /api/v1/monday/webhooks/:secret,
# 16+ chars: openssl rand -hex 24. monday webhooks made with a personal
# token carry no signature, so the secret path + "payload is only a
# trigger, every field is re-read from the API" is the authentication.
# Required in production. Unset in dev = the endpoint answers 404.
# MONDAY_WEBHOOK_SECRET=
# How often the scheduled backfill re-reads all three monday boards.
# 0 disables it (a WARN is logged at startup) — and then rows nobody opens
# never self-heal, because TTL-refresh-on-read only fires on a read.
MONDAY_BACKFILL_INTERVAL_HOURS=24
# Delay before the first run after boot, so a crash-looping container
# does not hammer monday with a full three-board read on every restart.
MONDAY_BACKFILL_FIRST_DELAY_MINUTES=15

# ─── Legacy-named, STILL USED with monday ───────────────────────────
# Named "HUBSPOT" for historical reasons (renaming is deferred); both
# apply to the ACTIVE CRM, i.e. monday.
# TTL for the refresh-on-read: reading a bound company or deal whose
# last_synced_at is older than this many seconds schedules a background
# re-read of its monday item.
HUBSPOT_SYNC_TTL_SECONDS=300
# Auto-post a note (a monday "update") after every document save and every
# first save of a calculator. Production MUST set true. Kept false in dev
# so local saves with a real token do not post onto real client cards.
AUTO_SYNC_TO_HUBSPOT=false

# ─── HubSpot (RETIRED — not needed) ─────────────────────────────────
# The HubSpot account no longer exists. With CRM_PROVIDER=monday none of
# these is required, and the HubSpot backfill, webhook processor and
# /ready probe do not run. Leave them commented out; a non-empty
# HUBSPOT_API_TOKEN must start with "pat-" or boot fails, so never put a
# placeholder there.
# HUBSPOT_API_TOKEN=
# HUBSPOT_API_BASE_URL=https://api.hubapi.com
# HUBSPOT_DEAL_PIPELINE_ID=
# HUBSPOT_WEBHOOK_SECRET=
# HUBSPOT_AUTO_BACKFILL=false
# HUBSPOT_COMPANY_TYPE_FILTER=direct_client
# HUBSPOT_BACKFILL_PAGE_SIZE=100

# ─── Puppeteer / PDF rendering ──────────────────────────────────────
# Phase 8: Puppeteer + headless Chromium bundled into the same Docker
# image. In dev, leave PUPPETEER_EXECUTABLE_PATH empty and Puppeteer
# uses its own bundled Chromium download.
PUPPETEER_EXECUTABLE_PATH=
PUPPETEER_HEADLESS=true
# Per-PDF render timeout, milliseconds. 30s comfortably covers the
# heaviest offer + agreement render in local benchmarks (~3-4s).
PDF_RENDER_TIMEOUT_MS=30000
# Browser recycle policy (defence against Chrome memory leak).
# Browser is killed + re-spawned after EITHER condition is hit.
PUPPETEER_RENDERS_PER_BROWSER=1000
PUPPETEER_BROWSER_TTL_MS=86400000

# ─── Document numbering ─────────────────────────────────────────────
# BSG-<7digit>-<6digit hubspot_id_suffix>. The 7-digit middle starts
# at 7100001 (Q14 confirmed). This value seeds the singleton row in
# `document_number_sequence` on first migration only — runtime reads
# it from the DB row, NOT from the env.
# The suffix is the last 6 chars of companies.hubspot_company_id (the
# legacy-named company key); for companies created from monday, whose
# key is "mon:<itemId>", that is the tail of the monday item id.
DOCUMENT_NUMBER_START=7100001

# ─── Logging / observability ────────────────────────────────────────
LOG_LEVEL=info
# When true, every inbound request is logged with timing + status.
LOG_HTTP_REQUESTS=true
