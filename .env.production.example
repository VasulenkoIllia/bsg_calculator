# ────────────────────────────────────────────────────────────────────
# BSG Calculator — PRODUCTION environment template (Sprint 7.3).
#
# DO NOT COMMIT a filled-in copy of this file. Drop it onto the host
# (as `<deploy-dir>/.env`) and let `docker compose` read it via the
# `env_file:` directive in `docker-compose.yml`.
#
# Every value marked `<REQUIRED>` MUST be replaced, and MONDAY_API_TOKEN
# (left empty, marked REQUIRED) MUST be filled in. The server's env
# validator (server/config/env.ts) refuses to boot on only SOME of these
# left as they are — an empty MONDAY_API_TOKEN and the
# TOTP_ENCRYPTION_KEY and MONDAY_WEBHOOK_SECRET placeholders — while
# others would boot as-is, so do not rely on it.
# ────────────────────────────────────────────────────────────────────

# ─── App identity ───────────────────────────────────────────────────
APP_NAME=bsg-calculator
APP_DOMAIN=<REQUIRED — e.g. app.example.com>
# Public https URL of the SPA — embedded as the clickable document link
# in every CRM note (a monday update). MUST be the real https origin;
# the env loader rejects http://localhost in production.
APP_PUBLIC_URL=https://<APP_DOMAIN>
NODE_ENV=production
PORT=8080
TZ=Europe/Kyiv

# ─── Reverse proxy (Traefik) ────────────────────────────────────────
# `proxy` is the conventional name of the external Docker network
# Traefik attaches to. Match the actual network on your host:
#   docker network ls | grep -E 'proxy|traefik'
TRAEFIK_NETWORK=proxy
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_TLS=true
TRAEFIK_CERTRESOLVER=cf
# Number of trusted reverse-proxy hops. Traefik in front of the app
# = 1. If you have CloudFlare → Traefik → app, it's 2. Wrong value
# lets clients spoof X-Forwarded-For and bypass per-IP rate limits.
TRUST_PROXY_HOPS=1

# ─── Database ───────────────────────────────────────────────────────
# The application container reads DATABASE_URL directly. In compose
# we rebuild it from the discrete vars so changing DB_PASSWORD here
# propagates to the URL automatically.
DATABASE_URL=postgres://bsg:<DB_PASSWORD>@postgres:5432/bsg_calculator
DB_HOST=postgres
DB_PORT=5432
DB_USER=bsg
# REQUIRED: 32+ char random string. Generate with:
#   openssl rand -base64 32 | tr -d '+=/'
DB_PASSWORD=<REQUIRED>
DB_NAME=bsg_calculator
DB_POOL_MAX=10
# How long a request waits for a free pool client before failing. pg's
# default is 0 = wait forever, which makes pool starvation look like the
# app simply hanging: no error, no log line, requests never answer.
DB_CONNECTION_TIMEOUT_MS=10000

# ─── Auth secrets ───────────────────────────────────────────────────
# REQUIRED: generate fresh per environment. The env loader REFUSES
# to boot if this is any of the well-known placeholder values.
#   openssl rand -base64 48
JWT_ACCESS_SECRET=<REQUIRED — run: openssl rand -base64 48>
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=12h
BCRYPT_COST=12
# TOTP 2FA secret-encryption key — REQUIRED in prod (app refuses to boot
# with the all-zero dev default). 64 hex chars: openssl rand -hex 32
TOTP_ENCRYPTION_KEY=<REQUIRED — run: openssl rand -hex 32>
# Also add a real key to the LOCAL .env so the 2FA dev flow encrypts
# secrets with a non-trivial key during testing.

# ─── CORS / frontend ────────────────────────────────────────────────
# Single-container deploy: Express serves the SPA from the same
# origin, so CORS is effectively same-origin. Set this to your real
# https origin for the legacy frontend-build path.
FRONTEND_ORIGIN=https://<APP_DOMAIN>

# ─── CRM provider ───────────────────────────────────────────────────
# monday.com is the ONLY CRM (production since 2026-08-28). The HubSpot
# account no longer exists: "hubspot" is neither a fallback nor a
# rollback target.
# Set this EXPLICITLY. The code default in server/config/env.ts is still
# "hubspot" (changing it is a deferred code change); without this line
# production refuses to boot asking for HUBSPOT_API_TOKEN /
# HUBSPOT_WEBHOOK_SECRET — do not "fix" that by supplying them.
# It selects the client the note-writer uses, the webhook processor that
# starts at boot, the API /ready probes and the CRM the TTL refresh reads
# from. A note is only ever torn down in the CRM that recorded it.
CRM_PROVIDER=monday

# ─── monday.com ─────────────────────────────────────────────────────
# REQUIRED: personal API token (Developer Center -> My access tokens).
# Every read and every note write goes through it. Left empty on
# purpose: production refuses to boot while it is empty, so a forgotten
# token fails at once. A wrong or revoked token still boots and surfaces
# at runtime instead — "[startup] monday API version assertion FAILED" in
# the log and "monday":"fail" (HTTP 503) on /ready.
MONDAY_API_TOKEN=
# Must be exactly this in production (SSRF guard for the token).
MONDAY_API_BASE_URL=https://api.monday.com/v2
# Pinned API version, asserted at boot. monday ships quarterly and an
# UNRECOGNISED value is silently downgraded instead of rejected, so the
# server checks that monday echoes back what we asked for and does not
# start the webhook processor or the scheduled backfill otherwise.
# Never leave blank.
MONDAY_API_VERSION=2026-07
# Board ids in the CRM workspace (the env.ts defaults are
# the real boards). Column ids are NOT env vars on purpose: they are
# resolved at runtime — recorded id first, then title + type — because
# mapped columns were deleted and recreated during the migration.
MONDAY_BOARD_COMPANIES=5102466967
MONDAY_BOARD_AGENTS=5102466950
MONDAY_BOARD_DEALS=5102466996
# These three must be DIFFERENT ids — boot refuses otherwise. The webhook
# receiver classifies an event by its board id, so a duplicate would route
# one board's events to the wrong object type with nothing in the logs to
# say so.
# REQUIRED: unguessable path segment of POST /api/v1/monday/webhooks/:secret,
# at least 16 chars. Generate with: openssl rand -hex 24
# It is part of the webhook URL registered in monday, so treat that URL as
# a secret (the app masks it in its own request log). monday does not sign
# personal-token webhooks, so this secret plus "the payload is only a
# trigger, every field is re-read from the API" is the authentication.
# Rotating it changes the URL: all 21 webhooks must be re-created.
# The placeholder is deliberately shorter than 16 chars, so a forgotten
# one refuses to boot.
MONDAY_WEBHOOK_SECRET=<REQUIRED>
# How often the scheduled backfill re-reads all three monday boards.
# 0 disables it (a WARN is logged at startup) — and then rows nobody opens
# never self-heal, because TTL-refresh-on-read only fires on a read.
MONDAY_BACKFILL_INTERVAL_HOURS=24
# Delay before the first run after boot, so a crash-looping container
# does not hammer monday with a full three-board read on every restart.
MONDAY_BACKFILL_FIRST_DELAY_MINUTES=15

# ─── Legacy-named, STILL USED with monday ───────────────────────────
# Named "HUBSPOT" for historical reasons (renaming is deferred); both
# apply to the ACTIVE CRM, i.e. monday.
# TTL for the refresh-on-read: reading a bound company or deal whose
# last_synced_at is older than this many seconds schedules a background
# re-read of its monday item.
HUBSPOT_SYNC_TTL_SECONDS=300
# MUST stay true. After every successful document save and every first
# save of a calculator, post a note (a monday "update") to the deal card
# when the row is pinned to a deal, otherwise to the company card. Runs
# in the background after the row is committed, so a CRM outage never
# blocks a save; a failed post leaves the row's sync state at "failed"
# and the "Sync to CRM" button retries it. The code default is false,
# and false silently stops all automatic notes.
# (The older name AUTO_SYNC_DOCUMENTS_TO_HUBSPOT is still read as a
# fallback when this one is absent.)
AUTO_SYNC_TO_HUBSPOT=true

# ─── HubSpot (RETIRED — not needed) ─────────────────────────────────
# The HubSpot account no longer exists. With CRM_PROVIDER=monday none of
# these is required, and the HubSpot backfill, webhook processor and
# /ready probe do not run. Leave them commented out; a non-empty
# HUBSPOT_API_TOKEN must start with "pat-" or boot fails, so never put a
# placeholder there.
# HUBSPOT_API_TOKEN=
# HUBSPOT_API_BASE_URL=https://api.hubapi.com
# HUBSPOT_WEBHOOK_SECRET=
# HUBSPOT_DEAL_PIPELINE_ID=
# HUBSPOT_COMPANY_TYPE_FILTER=direct_client
# HUBSPOT_BACKFILL_PAGE_SIZE=100
# HUBSPOT_AUTO_BACKFILL=false

# ─── PDF / Puppeteer ────────────────────────────────────────────────
# Set by the Dockerfile to /usr/bin/chromium (system Chromium). No
# need to override here in prod.
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
PUPPETEER_HEADLESS=true
PDF_RENDER_TIMEOUT_MS=30000
PUPPETEER_RENDERS_PER_BROWSER=1000
PUPPETEER_BROWSER_TTL_MS=86400000
# Sprint 7.4 escape hatch — set ONLY if Chromium fails to launch
# with "SUID sandbox helper binary was found, but is not configured
# correctly". That symptom means the Docker host lacks user-namespace
# remapping (default Coolify) and the setuid sandbox can't engage.
# Setting this to `true` reverts to --no-sandbox so PDF rendering
# works. Security trade-off documented in browser-pool.ts.
PUPPETEER_NO_SANDBOX=false

# ─── Document numbering ─────────────────────────────────────────────
DOCUMENT_NUMBER_START=7100001

# ─── SPA static path ────────────────────────────────────────────────
# Where Express finds the built SPA. Matches the Dockerfile layout —
# don't change unless you know what you're doing.
SPA_DIST_DIR=/srv/spa

# ─── Bootstrap super-admin (Phase 8 Stage 1) ────────────────────────
# Email of the user to auto-promote to `super_admin` on every server
# boot. Idempotent (already-super-admin = no-op), and the bootstrap
# NEVER demotes — if the env is cleared after promotion, the user
# keeps their role.
#
# Order matters: create the admin user FIRST with
#   docker compose exec app npx tsx server/scripts/create-user.ts \
#     --email=admin@your.com --password='...' --role=admin
# then set this var to their email + restart the app.
#
# Leave blank if your super-admin is already provisioned manually.
BOOTSTRAP_SUPER_ADMIN_EMAIL=

# ─── Logging ────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_HTTP_REQUESTS=true

# ─── App image (optional) ───────────────────────────────────────────
# If you push the image to a registry, point compose at the tagged
# version here. Leave unset to build locally on `docker compose up`.
# APP_IMAGE=ghcr.io/your-org/bsg-calculator:1.0.0
